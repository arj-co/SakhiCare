# ─── SakhiCare Configuration ───

# Port to bind backend server
PORT=8000

# OneSignal Configuration (for Real Push Notifications)
# 1. Sign up at https://onesignal.com
# 2. Create a new App named "SakhiCare"
# 3. Copy your App ID and REST API Key below
ONESIGNAL_APP_ID=your-onesignal-app-id-here
ONESIGNAL_REST_API_KEY=your-onesignal-rest-api-key-here

# Runtime environment
APP_ENV=development
AUTH_PROVIDER=supabase

# Supabase production configuration
SUPABASE_URL=https://sngvedrflxkwsrjwmcab.supabase.co
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_STORAGE_BUCKET=sakhicare-audio
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
# Use Supabase's pooled Postgres connection string in production.
SUPABASE_DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Local-only fallback; do not use in production.
DATABASE_URL=sqlite:///./sakhicare.db

# Exact portal origins, comma separated. Wildcard is forbidden in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:5175
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=
SMS_SENDER_ID=SAKHI
EMERGENCY_MO_PHONE=
SUPERVISOR_PHONE=
EMERGENCY_MO_PUSH_TARGET=
SUPERVISOR_PUSH_TARGET=
DEFAULT_EMERGENCY_CALLBACK=
CLINICAL_REVIEWER_NAME=
CLINICAL_REVIEWER_QUALIFICATIONS=
CLINICAL_REVIEWER_DESIGNATION=
CLINICAL_PROTOCOL_APPROVED_AT=
