# ─── SakhiCare Configuration ───

# Port to bind backend server
PORT=8000

# OneSignal Configuration (for Real Push Notifications)
# 1. Sign up at https://onesignal.com
# 2. Create a new App named "SakhiCare"
# 3. Copy your App ID and REST API Key below
ONESIGNAL_APP_ID=your-onesignal-app-id-here
ONESIGNAL_REST_API_KEY=your-onesignal-rest-api-key-here

# Optional: Cloud Database (Defaults to In-Memory / SQLite)
DATABASE_URL=sqlite:///./sakhicare.db
